    "init": "yarn && tsc && (cd docker; ./init.sh clean && ./init.sh setup)",
    "start": "(cd docker; ./up.sh)",
    "playerlist": "wget -O - http://host.docker.internal:8080/playerlist",
    "top": "wget -O - http://host.docker.internal:8080",
    "status": "wget -O - http://host.docker.internal:8080/status"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
