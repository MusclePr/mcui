{
  "name": "mcui",
  "version": "0.0.1",
  "description": "Minecraft Control UI",
  "main": "index.js",
  "author": "nakanotti",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "express": "^5.1.0",
    "express-basic-auth": "^1.2.1",
    "js-yaml": "^4.1.0",
    "minecraft-server-properties": "^1.0.0",
    "prismarine-nbt": "^2.2.1",
    "rcon-client": "^4.2.3"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.4.3",
    "@types/express": "^4.17.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^18.11.10"
  },
  "scripts": {
    "help": "cat ReadMe.md",
    "build": "tsc",
    "types": "tsc -d",
    "test": "node dist/test",
