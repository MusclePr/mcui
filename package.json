{
  "name": "mcui",
  "version": "0.0.1",
  "description": "Minecraft Control UI",
  "main": "index.js",
  "author": "MusclePr",
  "license": "UNLICENSED",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "axios": "^1.14.0",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "js-yaml": "^4.1.1",
    "minecraft-server-properties": "^1.0.0",
    "prismarine-nbt": "^2.8.0",
    "rcon-client": "^4.2.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.19",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "help": "cat ReadMe.md",
    "build": "tsc",
    "types": "tsc -d",
    "test": "node dist/test",
    "image": "docker image build -t MusclePr/mcui:latest .",
    "init": "npm ci && npm run build && (cd docker; ./init.sh clean && ./init.sh setup)",
    "start": "(cd docker; ./up.sh)",
    "playerlist": "wget -O - http://host.docker.internal:8080/playerlist",
    "top": "wget -O - http://host.docker.internal:8080",
    "status": "wget -O - http://host.docker.internal:8080/status"
  },
  "packageManager": "npm@11"
}
